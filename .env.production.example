# Production sozlamalari (docker compose). Nusxa oling:  cp .env.production.example .env
# Maxfiy qiymatlarni generatsiya qilish:  openssl rand -base64 48 | tr -d '/+=' | cut -c1-48

# Domen (DNS A yozuvi server IP'siga qaragan bo'lishi kerak) va Let's Encrypt uchun email
DOMAIN=domen.uz
ACME_EMAIL=admin@domen.uz

# PostgreSQL
POSTGRES_PASSWORD=

# Fayl ombori (SeaweedFS S3): ilova kaliti
S3_BUCKET=taklifnoma
S3_ACCESS_KEY=taklifnoma-app
S3_SECRET_KEY=

# Sessiya va RSVP imzolari (har biri kamida 32 belgi, har xil bo'lsin)
OWNER_JWT_SECRET=
COUPLE_JWT_SECRET=
RSVP_SECRET=

# Birinchi owner akkaunti (seed buyrug'i uchun; parol kamida 10 belgi)
OWNER_EMAIL=
OWNER_PASSWORD=

# Telegram (ixtiyoriy). Token bo'lsa webhook rejimi avtomatik yoqiladi.
TELEGRAM_BOT_TOKEN=
# 32-256 belgi: A-Z a-z 0-9 _ -
TELEGRAM_WEBHOOK_SECRET=
