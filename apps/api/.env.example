# --- Umumiy ---
NODE_ENV=development
PORT=3000
# Nginx/Cloudflare ortida bo'lsa: proksi "hop"lar soni (to'g'ri IP aniqlash va rate limit uchun)
TRUST_PROXY=0
# Mehmon sahifalari shu domen ostida: {PUBLIC_WEB_URL}/{slug}
PUBLIC_WEB_URL=http://localhost:4200
# Vergul bilan ajratilgan
CORS_ORIGINS=http://localhost:4200
# Production'da true (HTTPS)
COOKIE_SECURE=false

# --- Ma'lumotlar bazasi ---
DATABASE_URL=postgresql://taklifnoma:taklifnoma@localhost:5434/taklifnoma?schema=public

# --- Sessiyalar (kamida 32 belgi; generatsiya: openssl rand -base64 48) ---
OWNER_JWT_SECRET=change-me-owner-secret-at-least-32-characters-long
COUPLE_JWT_SECRET=change-me-couple-secret-at-least-32-characters-long

# --- S3 (lokal: SeaweedFS, docker-compose.dev.yml) ---
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=taklifnoma
S3_ACCESS_KEY=taklifnoma
S3_SECRET_KEY=taklifnoma-dev-secret
S3_FORCE_PATH_STYLE=true
# Fayllarning ochiq URL bazasi (CDN bo'lsa CDN manzili)
S3_PUBLIC_URL=http://localhost:8333/taklifnoma

# --- Seed (birinchi owner akkaunti) ---
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me-strong-password

# --- RSVP ---
# Forma tokenlarini imzolash va IP xeshlash (kamida 32 belgi)
RSVP_SECRET=change-me-rsvp-secret-at-least-32-characters-long

# --- Telegram ---
# @BotFather'dan olingan token. Bo'sh bo'lsa bot o'chiq.
TELEGRAM_BOT_TOKEN=
# off | polling (lokal dev) | webhook (production). Bo'sh bo'lsa avtomatik tanlanadi.
# Bot API manzili (odatda o'zgartirilmaydi)
TELEGRAM_API_URL=
TELEGRAM_MODE=
# Bitta bot production bilan bo'lishilgan bo'lsa: true bo'lsa lokal polling prod webhook'ini o'chirib botni oladi.
# false (default): webhook bor bo'lsa lokal faqat xabar yuboradi, prod'ga tegmaydi.
TELEGRAM_POLLING_TAKEOVER=false
# Faqat webhook rejimida:
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Mini App qisqa nomi (BotFather /newapp, URL: https://domen.uz/tg). "Faqat Telegram orqali javob" uchun kerak.
TELEGRAM_MINIAPP_NAME=
