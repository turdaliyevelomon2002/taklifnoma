{
  "name": "@taklifnoma/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend va backend uchun umumiy tiplar, Zod sxemalari va biznes qoidalari",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./enums": {
      "types": "./dist/types/enums.d.ts",
      "import": "./dist/esm/enums.js",
      "require": "./dist/cjs/enums.js"
    },
    "./phone": {
      "types": "./dist/types/phone-core.d.ts",
      "import": "./dist/esm/phone-core.js",
      "require": "./dist/cjs/phone-core.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json",
    "typecheck": "tsc -p tsconfig.cjs.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.spec.ts\""
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.19.4",
    "typescript": "~5.8.3"
  }
}
