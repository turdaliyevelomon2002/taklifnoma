# Caddy: Let's Encrypt sertifikatini avtomatik oladi va yangilaydi.
{
	email {$ACME_EMAIL}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# API (rasm/musiqa yuklash uchun 25 MB gacha)
	handle /api/* {
		request_body {
			max_size 25MB
		}
		reverse_proxy api:3000
	}

	# Yuklangan fayllar: /media/<key> -> MinIO /<bucket>/<key> (faqat o'qish)
	handle_path /media/* {
		@notget not method GET HEAD
		respond @notget 405
		rewrite * /{$S3_BUCKET}{uri}
		reverse_proxy minio:9000 {
			header_up Host {upstream_hostport}
			header_down -Server
			header_down -X-Amz-Request-Id
			header_down -X-Amz-Id-2
			# Fayl nomlari noyob (uuid): uzoq keshlash xavfsiz.
			header_down Cache-Control "public, max-age=31536000, immutable"
		}
	}

	# Qolgan hammasi: Angular SSR
	handle {
		reverse_proxy web:4000
	}
}
